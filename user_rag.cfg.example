# ==============================================================================
# Персональные настройки RAG для пользователей (User-specific RAG Configuration)
# ==============================================================================
# Формат: секция [TELEGRAM_USER_ID], внутри параметры:
# - top_k: количество чанков для поиска в ChromaDB (по умолчанию 4)
# - temperature: температура выборки LLM (по умолчанию 0.2)
# - max_tokens: максимум токенов в ответе (по умолчанию 1500)
# - model: идентификатор модели в LM Studio (по умолчанию local-model)
# - system_prompt: персональная инструкция/роль для ответов
# - chunk_size: размер чанка при нарезке документов (по умолчанию 500)
# - chunk_overlap: перекрытие чанков (по умолчанию 50)
#
# Любой параметр, который не указан, автоматически берется из общих настроек (.env).
#
# Чтобы активировать этот файл, скопируйте его в user_rag.cfg или укажите
# USER_RAG_CONFIG_FILE=user_rag.cfg в файле .env.

[6060196826]
top_k = 5
temperature = 0.1
max_tokens = 2000
model = qwen2.5-14b-instruct-1m
system_prompt = Ты — строгий эксперт-аналитик. Отвечай кратко и емко исключительно по предоставленному контексту.
chunk_size = 400
chunk_overlap = 40

[1980902576]
top_k = 3
temperature = 0.5
max_tokens = 1000
