# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Администраторы бота (через запятую): имеют доступ ко всем командам (/add_user, /ban_user, /stats, загрузка документов)
ADMIN_IDS=123456789,987654321

# Начальный белый список пользователей (через запятую): пользователи, которым разрешено задавать вопросы
ALLOWED_TELEGRAM_IDS=123456789,111222333

# ==============================================================================
# LM Studio (Local LLM Inference) Configuration
# ==============================================================================
# OpenAI-совместимый эндпоинт локального LM Studio
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio

# Название модели в LM Studio (можно оставить по умолчанию или указать точный ID загруженной модели)
LM_STUDIO_MODEL=local-model

# Параметры генерации
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500

# ==============================================================================
# Vector Store & CPU Embeddings Configuration
# ==============================================================================
# Модель FastEmbed на CPU (рекомендуется мультиязычная модель для RU/EN)
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Количество наиболее релевантных чанков для контекста (k=3..5)
RAG_TOP_K=4

# Параметры чанкинга
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ==============================================================================
# Персональные настройки RAG для пользователей (User-Specific RAG Configs)
# ==============================================================================
# Можно задать прямо строкой JSON (любые параметры: top_k, temperature, max_tokens, model, system_prompt, chunk_size, chunk_overlap):
# USER_RAG_CONFIGS='{"123456789": {"top_k": 5, "temperature": 0.1, "model": "qwen2.5-14b-instruct-1m"}}'

# Либо указать путь к отдельному конфигурационному файлу (.cfg, .ini или .json):
# USER_RAG_CONFIG_FILE=user_rag.cfg

# ==============================================================================
# Storage Paths
# ==============================================================================
CHROMA_PERSIST_DIR=data/chroma
DOCS_STORAGE_DIR=data/documents
SQLITE_DB_PATH=data/bot.db

# ==============================================================================
# Billing & Subscription Configuration
# ==============================================================================
# Режим оплаты: MANUAL (ручной перевод по реквизитам) или TELEGRAM_PAYMENTS (нативные платежи через Telegram)
PAYMENT_MODE=MANUAL

# Токен провайдера платежей (для ЮKassa / Сбербанк через @BotFather, если PAYMENT_MODE=TELEGRAM_PAYMENTS)
PAYMENT_PROVIDER_TOKEN=

# ==============================================================================
# Logging
# ==============================================================================
LOG_LEVEL=INFO
